#pragma once

/*
 * Copy this file to wifi_credentials.h and fill in your own details:
 *
 *     cp main/include/wifi_credentials.h.example main/include/wifi_credentials.h
 *
 * wifi_credentials.h is listed in .gitignore, so the real values never reach a
 * commit. Only this template is tracked.
 *
 * Use a 2.4 GHz network; the ESP32-S3 does not support 5 GHz Wi-Fi.
 */
#define WIFI_NETWORK_NAME "YOUR_2_4_GHZ_WIFI_NAME"
#define WIFI_NETWORK_PASSWORD "YOUR_WIFI_PASSWORD"
